{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "rootDirs": ["../../content/snippets", "./support/snippets"],
    "paths": {
      "react": ["node_modules/@types/react"],
      "react/jsx-runtime": ["node_modules/@types/react/jsx-runtime.d.ts"],
      "react-native": ["node_modules/react-native"],
      "@app/*": ["support/modules/*"],
      "*": ["node_modules/*"]
    },
    "typeRoots": ["./node_modules/@types"],
    "types": ["react", "jest"]
  },
  "include": [
    "../../content/snippets/**/react-native/**/*.tsx",
    "support/**/*.ts",
    "support/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
